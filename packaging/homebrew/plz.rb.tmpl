class Plz < Formula
  desc "Natural-language to shell-command CLI"
  homepage "https://github.com/sagwaco/pretty-plz"
  version "__VERSION__"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/sagwaco/pretty-plz/releases/download/v__VERSION__/plz-v__VERSION__-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA_AARCH64_DARWIN__"
    end
    on_intel do
      url "https://github.com/sagwaco/pretty-plz/releases/download/v__VERSION__/plz-v__VERSION__-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA_X86_64_DARWIN__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/sagwaco/pretty-plz/releases/download/v__VERSION__/plz-v__VERSION__-aarch64-unknown-linux-musl.tar.gz"
      sha256 "__SHA_AARCH64_LINUX__"
    end
    on_intel do
      url "https://github.com/sagwaco/pretty-plz/releases/download/v__VERSION__/plz-v__VERSION__-x86_64-unknown-linux-musl.tar.gz"
      sha256 "__SHA_X86_64_LINUX__"
    end
  end

  def install
    bin.install "plz"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/plz --version")
  end
end
